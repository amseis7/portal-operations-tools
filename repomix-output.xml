    </head>
    <body>
        <div class="container">
            <div class="card setup-card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center p-4">
                    <h3>🚀 Bienvenido</h3>
                    <p class="mb-0">Configuremos tu Portal de Operaciones</p>
                </div>
                <div class="card-body p-5">

                    <!-- Mensajes flash — VA AQUÍ, antes del form -->
                    {% with messages = get_flashed_messages(with_categories=true) %}
                      {% if messages %}
                        {% for category, message in messages %}
                          <div class="alert alert-{{ category }}">{{ message }}</div>
                        {% endfor %}
                      {% endif %}
                    {% endwith %}

                    <p class="text-muted mb-4">No se han detectado usuarios. Por favor, crea la cuenta del <strong>Administrador Principal</strong>.</p>  
                    <form method="POST">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}"/>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre Completo</label>
                            <input type="text" name="nombre" class="form-control" placeholder="Ej: Administrador del Sistema" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Correo Electrónico</label>
                            <input type="email" name="email" class="form-control" placeholder="admin@empresa.com">
                        </div>

                        <hr>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Usuario (Login)</label>
                            <input type="text" name="username" class="form-control" placeholder="admin" required>
                        </div>
                        
                        <!-- Campo password REEMPLAZADO — ahora con validación JS -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Contraseña Maestra</label>
                            <input type="password" name="password" id="setupPass" class="form-control" 
                                   required onkeyup="verificarPassword()">
                            <div id="passFeedback" class="small mt-2 p-2 bg-light border rounded d-none">
                                <ul class="list-unstyled mb-0" style="font-size: 0.85rem;">
                                    <li id="req-len" class="text-danger"><i class="bi bi-circle"></i> Mínimo 8 caracteres</li>
                                    <li id="req-num" class="text-danger"><i class="bi bi-circle"></i> Al menos un número</li>
                                    <li id="req-cap" class="text-danger"><i class="bi bi-circle"></i> Una mayúscula</li>
                                    <li id="req-sym" class="text-danger"><i class="bi bi-circle"></i> Un símbolo (!@#$...)</li>
                                </ul>
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-success btn-lg">Crear Cuenta e Iniciar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script src="{{ url_for('static', filename='js/bootstrap.bundle.min.js') }}"></script>
        <script>
            function verificarPassword() {
                const pass = document.getElementById('setupPass').value;
                const feedback = document.getElementById('passFeedback');

                const hasLen = pass.length >= 8;
                const hasNum = /\d/.test(pass);
                const hasCap = /[A-Z]/.test(pass);
                const hasSym = /[!@#$%^&*(),.?":{}|<>]/.test(pass);
                const allValid = hasLen && hasNum && hasCap && hasSym;

                if (pass.length === 0) {
                    feedback.classList.add('d-none');
                    return;
                }

                feedback.classList.toggle('d-none', allValid);

                const update = (id, ok) => {
                    const el = document.getElementById(id);
                    const texto = el.innerText.replace(/[✓✗] /, '');
                    el.className = ok ? 'text-success' : 'text-danger';
                    el.innerHTML = `<i class="bi bi-${ok ? 'check' : 'circle'}"></i> ${texto}`;
                };

                update('req-len', hasLen);
                update('req-num', hasNum);
                update('req-cap', hasCap);
                update('req-sym', hasSym);
            }
        </script>
    </body>
</html>
