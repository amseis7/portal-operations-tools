                            <li>
                                <a class="dropdown-item d-flex align-items-start py-2" href="{{ notif.link or '#' }}">
                                    <div class="me-2 mt-1">
                                        {% if notif.category == 'csirt' %}
                                        <i class="bi bi-shield-exclamation text-warning fs-5"></i>
                                        {% else %}
                                        <i class="bi bi-info-circle text-primary fs-5"></i>
                                        {% endif %}
                                    </div>
