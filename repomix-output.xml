<file path="app/static/css/custom.css">
/* =========================================================
   Portal de Operaciones CSIRT - Custom Styles
   ========================================================= */

/* ---------------------------------------------------------
   TYPOGRAPHY - Fira Code for technical data (IDs, hashes, IPs)
   --------------------------------------------------------- */
@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&display=swap');

:root {
    --portal-transition: 0.18s ease;
    --portal-shadow-hover: 0 4px 14px rgba(0, 0, 0, 0.12);
    --portal-shadow-lift:  0 6px 20px rgba(0, 0, 0, 0.15);
}

.font-monospace,
code {
    font-family: 'Fira Code', 'Courier New', monospace !important;
    font-size: 0.88em;
}

/* ---------------------------------------------------------
   ALERTS - Slide-in animation + left accent border
   --------------------------------------------------------- */
@keyframes slideInDown {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0);    }
}

.alert {
    border-left: 4px solid transparent;
    animation: slideInDown 0.25s ease;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
}
.alert-success { border-left-color: var(--bs-success); }
.alert-danger  { border-left-color: var(--bs-danger);  }
.alert-warning { border-left-color: var(--bs-warning); }
.alert-info    { border-left-color: var(--bs-info);    }
.alert-primary { border-left-color: var(--bs-primary); }

.alert .alert-icon {
    flex-shrink: 0;
    margin-top: 1px;
}
.alert .alert-body {
    flex: 1;
}

/* ---------------------------------------------------------
   CARDS - Smooth hover elevation
   --------------------------------------------------------- */
.card {
    transition: box-shadow var(--portal-transition);
}

/* Tool cards on dashboard lift on hover */
.tool-card {
    transition: transform var(--portal-transition), box-shadow var(--portal-transition);
}
.tool-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--portal-shadow-lift) !important;
}

/* ---------------------------------------------------------
   BUTTONS - Smooth press feedback
   --------------------------------------------------------- */
.btn {
    transition: filter var(--portal-transition),
                box-shadow var(--portal-transition),
                transform 0.1s ease;
}
.btn:active:not(:disabled) {
    transform: scale(0.97);
}

/* ---------------------------------------------------------
   FIX: White splotches on table-hover rows
   Bootstrap's .table-hover darkens the row, but child
   elements with their own background (badges, etc.) don't
   inherit the hover state, creating visible white/colored
   patches. This rule darkens those backgrounds on hover.
   --------------------------------------------------------- */
.table-hover tbody tr:hover .badge.bg-light,
.table-hover tbody tr:hover .badge.bg-white {
    background-color: var(--bs-gray-300) !important;
}
.table-hover tbody tr:hover .badge.bg-danger {
    background-color: var(--bs-red-700, #b02a37) !important;
}
.table-hover tbody tr:hover .badge.bg-warning {
    background-color: var(--bs-yellow-700, #9c6f1a) !important;
    color: #000 !important;
}
.table-hover tbody tr:hover .badge.bg-secondary {
    background-color: var(--bs-gray-600) !important;
}
.table-hover tbody tr:hover .badge.bg-info {
    background-color: var(--bs-cyan-700, #087990) !important;
    color: #fff !important;
}
.table-hover tbody tr:hover .badge.bg-success {
    background-color: var(--bs-green-700, #146c43) !important;
}

/* ---------------------------------------------------------
   NAVBAR
   --------------------------------------------------------- */
@media (max-width: 991.98px) {
    .navbar .input-group {
        min-width: 0 !important;
        width: 100%;
    }
}

/* Notification dropdown entrance */
.dropdown-menu {
    animation: slideInDown 0.15s ease;
}

/* ---------------------------------------------------------
   TABLES - General Improvements
   --------------------------------------------------------- */
.table > :not(caption) > * > * {
    padding-bottom: 0.6rem;
    padding-top: 0.6rem;
}
.table .font-monospace {
    word-break: break-all;
    overflow-wrap: break-word;
}
.table-hover tbody tr {
    transition: background-color 0.12s ease;
}

/* ---------------------------------------------------------
   CARDS - Consistent Headers
   --------------------------------------------------------- */
.card-header.bg-dark {
    font-size: 0.875rem;
}

/* ---------------------------------------------------------
   BADGES - Table Context
   --------------------------------------------------------- */
.table td .badge {
    vertical-align: middle;
}

/* ---------------------------------------------------------
   EMPTY STATE - Standardized no-data display
   --------------------------------------------------------- */
.empty-state {
    padding: 3.5rem 1rem;
    text-align: center;
}
.empty-state-icon {
    font-size: 2.75rem;
    opacity: 0.2;
    display: block;
    margin-bottom: 0.75rem;
}
.empty-state p {
    color: var(--bs-secondary);
    margin: 0;
    font-size: 0.95rem;
}

/* ---------------------------------------------------------
   FORMS - Feedback Improvements
   --------------------------------------------------------- */
.form-control:focus {
    box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
}

/* ---------------------------------------------------------
   LOGIN - Card styling
   --------------------------------------------------------- */
.card-login {
    max-width: 420px;
    margin: auto;
    margin-top: 80px;
}
.login-brand-icon {
    font-size: 2.5rem;
    color: var(--bs-primary);
}

/* ---------------------------------------------------------
   RESPONSIVE - Mobile Table Scroll
   --------------------------------------------------------- */
@media (max-width: 767.98px) {
    .table-responsive {
        font-size: 0.875rem;
    }
    .table .d-flex.gap-2 {
        flex-wrap: wrap;
        justify-content: center !important;
    }
}

/* ---------------------------------------------------------
   ACCESSIBILITY - Focus Indicators
   --------------------------------------------------------- */
a:focus-visible,
button:focus-visible,
.form-control:focus-visible,
.form-select:focus-visible,
.form-check-input:focus-visible {
    outline: 2px solid var(--bs-primary);
    outline-offset: 2px;
}

/* ---------------------------------------------------------
   PRINT - Clean output
   --------------------------------------------------------- */
@media print {
    .navbar, .btn, .dropdown, form {
        display: none !important;
    }
    .card {
        border: 1px solid #000 !important;
        box-shadow: none !important;
    }
}
</file>

