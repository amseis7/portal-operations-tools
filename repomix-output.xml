        response.headers['Permissions-Policy'] = 'camera=(), microphone=(), geolocation=()'
        return response
    
    if getattr(sys, 'frozen', False):
        migration_dir = os.path.join(sys._MEIPASS, 'migrations')
    else:
        migration_dir = 'migrations'

    try:
