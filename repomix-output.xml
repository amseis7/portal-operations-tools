<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Instalación Portal CSIRT</title>
        <!-- Cambiado de CDN a local -->
