                                        <button type="submit" class="btn btn-link p-0 text-secondary" title="Marcar leída"
                                            onclick="event.stopPropagation();">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                </a>
                            </li>
                            <li>
                                <hr class="dropdown-divider my-0">
                            </li>
                            {% endfor %}
                            <li><a class="dropdown-item text-center small text-primary py-2"
                                    href="{{ url_for('main.marcar_todas_leidas') }}" 
                                    onclick="event.preventDefault(); document.getElementById('formMarcarTodas').submit();">Marcar todas como leídas</a></li>
                            {% else %}
                            <li class="py-3 text-center text-muted small">No tienes notificaciones nuevas.</li>
                            {% endif %}
