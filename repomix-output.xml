</div>
<script>
(function() {
    function toggleFooter(selectEl) {
        var suffix = selectEl.id.replace('extension-', '');
        var footerGroup = document.getElementById('footer-group-' + suffix);
        if (!footerGroup) return;
        var ext = selectEl.value;
        footerGroup.style.display = (ext === 'xml' || ext === 'json') ? '' : 'none';
    }

    var selects = document.querySelectorAll('select[id^="extension-"]');
    selects.forEach(function(sel) {
        toggleFooter(sel);
        sel.addEventListener('change', function() {
            toggleFooter(sel);
        });
    });
})();
</script>
{% endblock %}
